###############################################################################
# Jalase - environment template
# Copy this file to `.env` at the repo root, then fill in real values.
# Never commit a real `.env` file.
#
#   cp .env.example .env
#
# The API also reads `apps/api/.env` (optional overrides). Prefer keeping
# secrets in one place: the root `.env`.
###############################################################################

# ── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults (Postgres on host port 5434)
DATABASE_URL=postgresql://jalase:jalase_dev@localhost:5434/jalase_dev

# ── API server ──────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
API_PUBLIC_URL=http://localhost:3000

# Generate a long random string for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# free | plus | pro | enterprise
# OSS builds grant Plus-tier features without a payment gateway
DEFAULT_TIER=plus

# Billing / Zibal is disabled unless you explicitly restore PaymentsModule
# PAYMENTS_ENABLED=false

# ── Mobile / PWA (Expo public) ──────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── Browser extension ───────────────────────────────────────────────────────
WXT_API_URL=http://localhost:3000/api/v1
WXT_APP_URL=http://localhost:8081

# ── Speech / LLM (OpenAI-compatible) ────────────────────────────────────────
# Any OpenAI-compatible provider works. AvalAI is one option for IR networks.
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize
AVALAI_TRANSCRIBE_MODEL=groq.whisper-large-v3
AVALAI_HYBRID_PIPELINE=true
AVALAI_LIVE_DIARIZE=false
AVALAI_REFINE_MODEL=qwen3.5-flash
AVALAI_REFINE_ENABLED=true
AVALAI_EXTRACT_MODEL=qwen3.5-flash
AVALAI_EXTRACT_ENABLED=true

# Default ASR language: en | fa (override per request when needed)
TRANSCRIBE_LANGUAGE=en

# Optional absolute path if ffmpeg is not on PATH
# FFMPEG_PATH=

# ── Legacy billing (commented - optional, disabled by default) ─────────────
# Uncomment only if you re-enable PaymentsModule in apps/api/src/app.module.ts
# ZIBAL_MERCHANT=zibal
# PAYMENT_RETURN_URL=http://localhost:8081/subscription/result
# PAYMENT_RETURN_ALLOWED_HOSTS=localhost,127.0.0.1
# ZIBAL_ALLOW_DEV_SIMULATE=false
