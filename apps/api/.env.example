###############################################################################
# API overrides (optional)
# Prefer configuring secrets in the repo-root `.env`.
# Values here override the root file when both are present.
###############################################################################

# DATABASE_URL=postgresql://jalase:jalase_dev@localhost:5434/jalase_dev
# JWT_SECRET=change-me-in-production-use-a-long-random-string

# OpenAI-compatible speech + LLM provider (no hard-coded default URL)
LLM_API_KEY=
LLM_BASE_URL=
DIARIZE_MODEL=gpt-4o-transcribe-diarize
ASR_MODEL=whisper-large-v3
HYBRID_PIPELINE=true
# Keep false for live transcription (diarization is slow)
LIVE_DIARIZE=false
REFINE_MODEL=gpt-4o-mini
REFINE_ENABLED=true
EXTRACT_MODEL=gpt-4o-mini
EXTRACT_ENABLED=true
JUDGE_MODEL=gpt-4o-mini
TRANSCRIBE_LANGUAGE=en
AI_LOCALE=en

# Structured logging + latency metrics
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_ENABLED=false

# Optional: absolute path to ffmpeg if not on PATH
# FFMPEG_PATH=
